/**
 * tsconfig.app.json
 * Configuration TypeScript pour le code source de l'application (src/).
 *
 * Points clés :
 * - "strict": true → active toutes les vérifications strictes TypeScript
 * - "paths" → définit l'alias "@" pour correspondre à vite.config.ts
 * - "noEmit": true → TS vérifie uniquement les types, Vite gère la compilation
 * - "moduleResolution: bundler" → compatible avec la résolution de modules de Vite
 */
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    /* Vite compile, TS vérifie seulement les types */
    "noEmit": true,
    /* Compatible avec la résolution de modules Vite/bundler */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    /* Chaque fichier est un module isolé (requis pour Vite) */
    "isolatedModules": true,
    /* Active le JSX React moderne (pas besoin d'importer React) */
    "jsx": "react-jsx",
    /* Active toutes les vérifications strictes TypeScript */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* Base pour la résolution des chemins */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    /* Alias "@" → src/ (doit correspondre à vite.config.ts) */
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}